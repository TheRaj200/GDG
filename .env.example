# ==============================================================================
# Kisan Ai - Backend Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Google Gemini API Key (Required for Live Voice & Plan Synthesis)
# Models used: gemini-2.5-flash, gemini-2.0-flash-exp
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection URI (Optional: Falls back to robust In-Memory Store if omitted)
# Example: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/kisan_ai?retryWrites=true&w=majority
MONGODB_URI=

# Optional CEDA API Key for Long-term Historical Mandi Trends
CEDA_API_KEY=6d5953ff8e910cfee69779d63999fc893383daffac092b387ba070ab8563eaba
